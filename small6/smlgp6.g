#############################################################################
##
#F SMALL_GROUPS_PROPERTIES_FUNCS[ 12 ]( size, inforec )
##
## the ranges below are the ones described by SMALL_GROUPS_INFORMATION[ 12 ]
##
SMALL_GROUPS_PROPERTIES_FUNCS[ 12 ] := function( size, inforec )
    local abel;

    # the nilpotent groups of both orders are those of order 128 times a
    # fixed group, in the same order; 1152 has one block per group of order 9
    abel := List( IdsOfAllSmallGroups( 128, IsAbelian, true ), x -> x[ 2 ] );

    if size = 1152 then
        # 1152 = 2^7 * 3^2, hence all these groups are solvable
        return rec( isAbelian       := SMALL_IDS_FROM_LIST(
                        Concatenation( abel, abel + 2328 ) ),
                    isNilpotent     := [ [ 1 .. 4656 ] ],
                    isSupersolvable := SMALL_IDS_DIFFERENCE(
                        [ [ 1 .. 157877 ] ],
                        SMALL_GROUPS_1152_NOT_SUPERSOLVABLE ),
                    isSolvable      := [ [ 1 .. 157877 ] ] );
    elif size = 1920 then
        # supersolvable exactly with a normal Hall (3,5)-subgroup, which is
        # cyclic of order 15 with a 2-group quotient
        return rec( isAbelian       := SMALL_IDS_FROM_LIST( abel ),
                    isNilpotent     := [ [ 1 .. 2328 ] ],
                    isSupersolvable := [ [ 1 .. 236344 ] ],
                    isSolvable      := [ [ 1 .. 240416 ] ] );
    fi;

    Error( "SMALL_GROUPS_PROPERTIES_FUNCS[ 12 ]: wrong call" );
end;
